# ================================================================
# ALI RAZA PORTFOLIO - ENVIRONMENT CONFIGURATION
# Copy this file to .env before running locally or add to Vercel Env
# ================================================================

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aliraza_portfolio?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_characters
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used during DB seeding or setup)
ADMIN_EMAIL=aliraza777212@gmail.com
ADMIN_PASSWORD=change_this_secure_password_123

# Port for local standalone Express server (Optional, default 5000)
PORT=5000

# Optional SMTP Email Configuration (If omitted, contact messages are stored in MongoDB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=aliraza777212@gmail.com

# Client-side optional API override (defaults to relative /api)
# VITE_API_URL=/api
